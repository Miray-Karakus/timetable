rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is a signed-in user with the custom claim role == "admin"
    // OR a document at admins/{uid} (can be created from the Firebase console).
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.get('role', '') == 'admin'
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isMeeting(m) {
      return m is map
        && m.keys().hasOnly(['day', 'start', 'end', 'room', 'type'])
        && m.keys().hasAll(['day', 'start', 'end', 'room', 'type'])
        && m.day in ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT']
        && isTime(m.start) && isTime(m.end) && m.start < m.end
        && m.room is string && m.room.size() <= 20
        && m.type in ['LECTURE', 'LAB', 'TUTORIAL'];
    }

    // 0–10 meetings (a course may have no published times yet).
    // Rules have no loops, so each index is checked explicitly.
    function validMeetings(ms) {
      return ms is list && ms.size() <= 10
        && (ms.size() < 1 || isMeeting(ms[0]))
        && (ms.size() < 2 || isMeeting(ms[1]))
        && (ms.size() < 3 || isMeeting(ms[2]))
        && (ms.size() < 4 || isMeeting(ms[3]))
        && (ms.size() < 5 || isMeeting(ms[4]))
        && (ms.size() < 6 || isMeeting(ms[5]))
        && (ms.size() < 7 || isMeeting(ms[6]))
        && (ms.size() < 8 || isMeeting(ms[7]))
        && (ms.size() < 9 || isMeeting(ms[8]))
        && (ms.size() < 10 || isMeeting(ms[9]));
    }

    function isValidCourse(d) {
      return d.keys().hasOnly(['department', 'category', 'semester', 'code', 'name', 'sectionNo', 'instructorName',
                               'credits', 'prerequisites', 'meetings'])
        && d.keys().hasAll(['department', 'category', 'semester', 'code', 'name', 'sectionNo', 'instructorName',
                            'credits', 'prerequisites', 'meetings'])
        && d.department is string && d.department.size() >= 1 && d.department.size() <= 80
        && d.category in ['core', 'technical', 'free']
        && d.semester in [1, 3, 5, 7]
        && d.code is string && d.code.matches('^[A-Z]{2,10}[0-9]{2,4}[A-Z]?$')
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 120
        && d.sectionNo is string && d.sectionNo.matches('^[0-9]{2}$')
        && d.instructorName is string && d.instructorName.size() <= 80
        && d.credits is int && d.credits >= 0 && d.credits <= 30
        && d.prerequisites is string && d.prerequisites.size() <= 200
        && validMeetings(d.meetings);
    }

    // Fall course sections: public to read, admin-only to change.
    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCourse(request.resource.data);
      allow delete: if isAdmin();
    }

    // Admin markers. Users may only check their own; managed from the console / scripts.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
